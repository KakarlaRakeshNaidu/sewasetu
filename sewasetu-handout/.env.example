# Copy privately; generate independent secrets. Never commit the populated .env.
APP_ENV=production
PUBLIC_BASE_URL=https://YOUR_OWN_HOST
SECRET_KEY=
OTP_HMAC_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
DATABASE_URL=postgresql+psycopg2://portal_runtime:GENERATED_PASSWORD@db:5432/sewasetu
# Operator-only environment: never supply these three values to the web container.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_PASSWORD=
RUNTIME_DATABASE_PASSWORD=
SMS_GATEWAY_URL=http://smsgw:8025
UPLOAD_DIR=/var/sewasetu/uploads
SESSION_COOKIE_SECURE=true
TRUST_PROXY=1
SCHEME_DEADLINE=2026-11-01T00:00:00+05:30
MIN_AGE=60
SLA_DAYS=15
DB_POOL_SIZE=3
DB_POOL_OVERFLOW=1
